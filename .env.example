# Public https origin the app is served from, no trailing slash.
# Coolify sets the domain; this must match it exactly.
APP_ORIGIN=https://horario.example.org

# Fénix → Pessoal → Gerir aplicações. Calendar access only.
FENIX_CLIENT_ID=
FENIX_CLIENT_SECRET=

# Must equal ${APP_ORIGIN}/api/fenix/callback and be registered in Fénix.
FENIX_REDIRECT_URI=https://horario.example.org/api/fenix/callback

# Random value, at least 32 characters: openssl rand -base64 48
FENIX_COOKIE_SECRET=

# Port the container listens on. Coolify reads this from the compose file.
PORT=3000
