# Public https origin the app is served from. A trailing slash is tolerated.
# Everything else is derived from this, including the OAuth redirect URI.
APP_ORIGIN=https://horario.example.org

# Fénix → Pessoal → Gerir aplicações. Calendar access only.
FENIX_CLIENT_ID=
FENIX_CLIENT_SECRET=

# Random value, at least 32 characters: openssl rand -base64 48
FENIX_COOKIE_SECRET=

# Optional. The redirect URI is always ${APP_ORIGIN}/api/fenix/callback; set this
# to the value registered in Fénix and a domain change that was not mirrored
# there makes the app report itself unconfigured instead of failing at Fénix.
# FENIX_REDIRECT_URI=https://horario.example.org/api/fenix/callback
